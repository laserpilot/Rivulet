use neon::prelude::*;

mod syphon_output;
use syphon_output::SyphonOutput;

#[neon::main]
fn main(mut cx: ModuleContext) -> NeonResult<()> {
    // Export the SyphonOutput class
    cx.export_function("createSyphonOutput", SyphonOutput::js_new)?;
    
    // Export SyphonOutput methods as standalone functions
    cx.export_function("updateFrame", SyphonOutput::js_update_frame)?;
    cx.export_function("hasClients", SyphonOutput::js_has_clients)?;
    cx.export_function("stop", SyphonOutput::js_stop)?;
    
    // Export platform detection utilities
    cx.export_function("getPlatform", get_platform)?;
    cx.export_function("isMacOS", is_macos)?;
    cx.export_function("isWindows", is_windows)?;
    
    Ok(())
}

fn get_platform(mut cx: FunctionContext) -> JsResult<JsString> {
    Ok(cx.string(std::env::consts::OS))
}

fn is_macos(mut cx: FunctionContext) -> JsResult<JsBoolean> {
    Ok(cx.boolean(cfg!(target_os = "macos")))
}

fn is_windows(mut cx: FunctionContext) -> JsResult<JsBoolean> {
    Ok(cx.boolean(cfg!(target_os = "windows")))
}
